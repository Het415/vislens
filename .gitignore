# Data and weights are never committed. Download scripts rebuild them; model
# artifacts ship as GitHub Release assets. See CLAUDE.md.
data/abo/
data/shards/
data/abo/
data/catalog/
data/near_dup_set/
data/*.parquet
data/*.npy
*.tar
*.onnx
*.pt
*.pth
*.joblib

# Rule thresholds ARE committed — they are configuration with a provenance
# record, not derived data, and the eval report has to be able to name the exact
# thresholds it measured. They no longer need an exception here, because as of
# 2026-09-21 they live inside the package (`src/vislens/rules/rules_v1.json` and
# `thresholds_v1.json`) rather than under `data/`, so that a wheel carries them.

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Eval reports ARE committed (dated markdown + jsonl). Scratch output is not.
eval/scratch/

# macOS
.DS_Store
